# Copy to /opt/clearfork-insurance/.env.staging on the droplet.
# Staging app: container port 8081 (Docker network only). Caddy on :3001 reverse_proxies to it.
# NEXT_PUBLIC_* in this file do not change the client bundle: prod and staging share the same image build.

NODE_ENV=production
PORT=8081

DB_HOST=mysql
DB_PORT=3306
DB_USER=clearfork_user
# Must match mysql password in docker-compose for clearfork_user
DB_PASSWORD=ClearFork2024SecureDB!
# Separate from production; create DB once (see mysql-init/99-staging-database.sql)
DB_NAME=clearfork-insurance-staging
# Accept either name used in code
DB_DATABASE=clearfork-insurance-staging

# Must differ from production; rotate if leaked
JWT_SECRET=change-me-staging-only

# Copy safe keys from prod or use test keys; never use prod reCAPTCHA secrets for abuse if unsure
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
GEMINI_API_KEY=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
